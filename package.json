{
  "name": "agro-predict-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write src README.md *.json *.yaml",
    "format:check": "prettier --check src README.md *.json *.yaml"
  },
  "dependencies": {
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/material": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@fontsource-variable/inter": "^5.2.8",
    "ngx-herald": "^1.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "jsdom": "^28.1.0",
    "prettier": "3.6.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0"
  }
}
